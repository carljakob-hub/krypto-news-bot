# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env NIEMALS committen oder weitergeben.

# --- Betriebsmodus ---------------------------------------------------------
# test        = Beiträge nur ins lokale Protokoll (data/posts.log) und,
#               falls gesetzt, in TELEGRAM_TEST_CHAT_ID.
# production  = Beiträge in TELEGRAM_CHAT_ID. Erfordert einen erfolgreichen
#               "newsbot preflight" für die aktuelle Konfiguration.
NEWSBOT_MODE=test

# --- Telegram (ERFORDERLICH für Telegram-Versand) ---------------------------
# Token von @BotFather, Format 123456789:AA...
TELEGRAM_BOT_TOKEN=
# ID der Zielgruppe für den Produktivbetrieb (Supergruppen beginnen mit -100)
TELEGRAM_CHAT_ID=
# Optional: private Testgruppe für den Testmodus
TELEGRAM_TEST_CHAT_ID=
# Optional: Nur in ein bestimmtes Thema schreiben (Gruppen mit Themen/Topics).
# So findest du die Nummer: In der App eine Nachricht im gewünschten Thema lange
# drücken → "Link kopieren". Der Link sieht aus wie https://t.me/c/1234567890/12/345
# Die mittlere Zahl (hier 12) ist die Themen-Nummer.
# Aus der ersten Zahl ergibt sich auch die Gruppen-ID: -100 davor, also -1001234567890.
TELEGRAM_TOPIC_ID=
TELEGRAM_TEST_TOPIC_ID=
# Optional: Chat für Betriebswarnungen (z. B. dein privater Chat mit dem Bot)
TELEGRAM_ADMIN_CHAT_ID=

# --- Sprachmodell (OPTIONAL) ----------------------------------------------
# Ohne Schlüssel arbeitet der Bot mit deterministischen Textvorlagen.
# Das Sprachmodell formuliert nur Texte; es entscheidet nie über den Prüfstatus.
ANTHROPIC_API_KEY=

# --- Pfade (optional) --------------------------------------------------------
NEWSBOT_CONFIG=config/config.yaml
NEWSBOT_SOURCES=config/sources.yaml
NEWSBOT_DB_PATH=data/newsbot.sqlite3
NEWSBOT_LOG_LEVEL=INFO
